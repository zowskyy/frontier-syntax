    {
      "id": "ReDoS_lexer",
      "category": "attack_vector",
      "title": "Regular Expression Denial of Service",
      "content": "Malicious input could cause catastrophic backtracking in lexer regex patterns. Mitigation: re2c v3.1 DFA lexer (O(n)); adversarial inputs tested per token; 0.1s timeout threshold.",
      "severity": "high",
      "tags": [
        "security",
        "mitigated"
      ],
      "source": "scripts/test_redos.py"
    },
    {
      "id": "homoglyph_injection",
      "category": "attack_vector",
      "title": "Unicode Homoglyph Identifier Injection",
      "content": "Unicode lookalike characters in identifiers could bypass keyword checks. Mitigation: ASCII-only identifiers [A-Za-z_][A-Za-z0-9_]*; UTF-8 NFC normalization before lexing.",
      "severity": "medium",
      "tags": [
        "security",
        "mitigated"
      ],
      "source": "syntax/lexicon.ebnf"
    },
    {
      "id": "keyword_prefix_ambiguity",
      "category": "attack_vector",
      "title": "Keyword Prefix Ambiguity",
      "content": "Identifiers like 'iff' or 'ifoo' could be mis-tokenized as keywords. Mitigation: Negative lookahead (?![A-Za-z0-9_]) on all keywords; 'iff' explicitly banned.",
      "severity": "medium",
      "tags": [
        "security",
        "mitigated"
      ],
      "source": "syntax/token_regex_table.json"
    },
    {
      "id": "wasm_parser_adversarial",
      "category": "attack_vector",
      "title": "Adversarial WASM Parser Input",
      "content": "Malformed WASM or oversized inputs to parser could crash or hang runtime. Mitigation: Cycle 6 adversarial attack surface audit; fuzz command (1000 iterations); SHA-3 final hash.",
      "severity": "high",
      "tags": [
        "security",
        "mitigated"
      ],
      "source": "syntax/wasm/wasm_parser_v2.wasm"
    },
    {
      "id": "ipfs_gateway_ssrf",
      "category": "attack_vector",
      "title": "IPFS Gateway SSRF",
      "content": "Malicious import paths could target internal network via IPFS gateway fetch. Mitigation: CID validation; 10s timeout; ipfs:// prefix enforcement; content hash verification.",
      "severity": "medium",
      "tags": [
        "security",
        "partial"
      ],
      "source": "src/ipfs/resolver.rs"
    },
    {
      "id": "pq_signature_forgery",
      "category": "attack_vector",
      "title": "Post-Quantum Signature Forgery",
      "content": "Forged PQ signatures on AST artifacts could bypass integrity checks. Mitigation: Dilithium3 (NIST PQC finalist) sign/verify on canonical AST bytes.",
      "severity": "high",
      "tags": [
        "security",
        "mitigated"
      ],
      "source": "src/pq_signatures.rs"
    },
    {
      "id": "zk_proof_bypass",
      "category": "attack_vector",
      "title": "ZK-SNARK Proof Bypass",
      "content": "Invalid Groth16 proofs could allow unverified AST to pass verification. Mitigation: arkworks Groth16 BN254; AST hash commitment circuit; proof deserialization validation.",
      "severity": "high",
      "tags": [
        "security",
        "mitigated"
      ],
      "source": "src/zk/verifier.rs"
    },
