// ---------------------------------------------------------------------------
// Release phases (Phase 0–8)
// ---------------------------------------------------------------------------

type ReleasePhase = {
    id: int,
    name: String,
    slice_range: String,
    deliverable: String,
    gate: String,
};

component ReleaseRoadmap {
    fn phases() -> Vec<ReleasePhase> {
        vec![
            phase(0, "Foundation", "0-3", "secure repository foundation", "tests + configuration + workspace security + audit log"),
            phase(1, "Model and Tools", "4-8", "safe model-to-tool execution loop", "model cannot bypass policy; edits transactional"),
            phase(2, "Knowledge", "9-16", "local project-aware retrieval", "FTS without Chroma; malicious docs cannot obtain authority"),
            phase(3, "Agent", "17-21", "recoverable coding agent", "mock-model agent completes deterministic fixtures"),
            phase(4, "Extensibility", "18-19", "isolated plugin system", "malicious plugins cannot escape capability boundary"),
            phase(5, "Security", "22", "automated adversarial security suite", "zero critical/high release-blocking findings"),
            phase(6, "Evaluation", "23-26", "reliability augmentation model E2E benchmarks", "results reproducible stored as artifacts"),
            phase(7, "Mobile", "27-30", "Android and iOS deployment tracks", "one real device per platform completes minimum offline workflow"),
            phase(8, "Release Engineering", "31-36", "v1.0.0 release candidate and public release", "all evidence collected independently reproducible"),
        ]
    }

    fn phase(id: int, name: String, slice_range: String, deliverable: String, gate: String) -> ReleasePhase {
        ReleasePhase { id, name, slice_range, deliverable, gate }
    }
}

// ---------------------------------------------------------------------------
// Three-pass implementability review
// ---------------------------------------------------------------------------

type ImplementabilityReview = {
    pass: int,
    name: String,
    result: String,
    conditions: Vec<String>,
};

component ImplementabilityReviews {
    fn all_passes() -> Vec<ImplementabilityReview> {
        vec![
            ImplementabilityReview {
                pass: 1,
                name: "Structural",
                result: "PASS",
                conditions: vec![
                    "each slice buildable independently",
                    "dependencies explicit",
                    "interfaces defined before consumers",
                    "persistent state defined",
                    "security boundaries explicit",
                ],
            },
            ImplementabilityReview {
                pass: 2,
                name: "Operational",
                result: "PASS",
                conditions: vec![
                    "run without internet via MockProvider",
                    "Chroma removable",
                    "model replaceable",
                    "plugins fail independently",
                    "recovery after interruption",
                ],
            },
            ImplementabilityReview {
                pass: 3,
                name: "Security/Release",
                result: "PASS",
                conditions: vec![
                    "model output cannot directly execute privileged actions",
                    "retrieved documents cannot grant authority",
                    "SSRF controls on network tools",
                    "checkpoints cannot execute code",
                    "stale edits cannot overwrite user changes",
                ],
            },
        ]
    }
}

// ---------------------------------------------------------------------------
// Final acceptance matrix
// ---------------------------------------------------------------------------

type AcceptanceRow = {
    area: String,
    requirement: String,
    status: String,
};

component FinalAcceptanceMatrix {
    fn rows() -> Vec<AcceptanceRow> {
