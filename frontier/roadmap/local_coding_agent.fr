// ---------------------------------------------------------------------------
// Dependency audit findings (Audit 1)
// ---------------------------------------------------------------------------

type DependencyAudit = {
    component: String,
    status: VerificationStatus,
    required_change: String,
};

component Audit1_DependencyVerification {
    fn findings() -> Vec<DependencyAudit> {
        vec![
            DependencyAudit {
                component: "qwen3_coder_7b",
                status: VerificationStatus::INVALID_AS_WRITTEN,
                required_change: "Replace with model compatibility matrix; Ollama exposes 30B/480B not 7B",
            },
            DependencyAudit {
                component: "ollama",
                status: VerificationStatus::VERIFIED,
                required_change: "Never sole inference abstraction",
            },
            DependencyAudit {
                component: "chromadb",
                status: VerificationStatus::REPLACED,
                required_change: "Replaceable semantic layer; SQLite authoritative; FTS5 fallback",
            },
            DependencyAudit {
                component: "nomic_embed_text",
                status: VerificationStatus::VERIFIED,
                required_change: "Configurable embedding; persist model_id revision dimension chunking",
            },
            DependencyAudit {
                component: "llama_cpp",
                status: VerificationStatus::VERIFIED,
                required_change: "Direct inference portability layer; Android ARM64 + iOS XCFramework",
            },
            DependencyAudit {
                component: "python_on_mobile",
                status: VerificationStatus::PARTIALLY_VERIFIED,
                required_change: "Android Termux route; iOS Swift + llama.cpp — no iOS Python dependency",
            },
        ]
    }
}

// ---------------------------------------------------------------------------
// Security audit findings (Audit 1 + Audit 2)
// ---------------------------------------------------------------------------

type SecurityFinding = {
    id: String,
    category: String,
    severity: String,
    mitigation: String,
};

component Audit1_SecurityFindings {
    fn critical_additions() -> Vec<SecurityFinding> {
        vec![
            SecurityFinding {
                id: "SEC-CAP-001",
                category: "capability_authorization",
                severity: "critical",
                mitigation: "Every tool call authorized outside model via policy engine",
            },
            SecurityFinding {
                id: "SEC-NET-001",
                category: "network_policy",
                severity: "critical",
                mitigation: "Explicit capability; SSRF controls; private IP block; redirect validation",
            },
            SecurityFinding {
                id: "SEC-PLG-001",
                category: "plugin_sandbox",
                severity: "critical",
                mitigation: "Subprocess plugins with restricted IPC and capability tokens",
            },
            SecurityFinding {
                id: "SEC-INJ-001",
                category: "prompt_injection",
                severity: "critical",
                mitigation: "Retrieved content untrusted; documents cannot grant authority",
            },
            SecurityFinding {
                id: "SEC-CHK-001",
                category: "checkpoint_safety",
                severity: "critical",
                mitigation: "No pickle deserialization; SQLite + JSON + checksums + schema versioning",
            },
        ]
    }
}

component Audit2_ThreatModel {
    fn default_policy() -> String {
        String::from(
            "READ=workspace; WRITE=transactional; DELETE=approval; SHELL=sandbox+capability; \
             NETWORK=disabled; PLUGIN=subprocess+token; SECRETS=deny"
        )
    }

    fn trust_boundary_position() -> String {
        String::from("Policy engine between T3/T4/T5 and privileged operations")
    }
}

// ---------------------------------------------------------------------------
// Reliability invariants (Audit 1)
// ---------------------------------------------------------------------------

type ReliabilityInvariant = {
    id: String,
    statement: String,
};

component Audit1_ReliabilityInvariants {
    fn invariants() -> Vec<ReliabilityInvariant> {
        vec![
            ReliabilityInvariant { id: "REL-001", statement: "No partial file edit may be committed" },
            ReliabilityInvariant { id: "REL-002", statement: "No tool may escape capability scope" },
            ReliabilityInvariant { id: "REL-003", statement: "Every mutating action has audit record" },
            ReliabilityInvariant { id: "REL-004", statement: "Every task has idempotency identifier" },
            ReliabilityInvariant { id: "REL-005", statement: "Every external process has timeout" },
            ReliabilityInvariant { id: "REL-006", statement: "Every subprocess has memory/output limits" },
            ReliabilityInvariant { id: "REL-007", statement: "Every index update is transactional" },
            ReliabilityInvariant { id: "REL-008", statement: "Failed task cannot silently mark success" },
            ReliabilityInvariant { id: "REL-009", statement: "Model restart cannot corrupt persistent state" },
            ReliabilityInvariant { id: "REL-010", statement: "Recovery resumes from deterministic checkpoint boundary" },
        ]
    }
}

// ---------------------------------------------------------------------------
// Data model (Audit 3)
// ---------------------------------------------------------------------------

type ProjectRecord = { id: String, root_path: String, name: String };
type FileRecord = { id: String, project_id: String, relative_path: String, sha256: String };
type DocumentRecord = { id: String, project_id: String, source_hash: String, embedding_model: String };
type ChunkRecord = { id: String, document_id: String, ordinal: int, text: String, hash: String };
type TaskRecord = { id: String, project_id: String, user_request: String, status: AgentTaskStatus };
type EventRecord = { id: String, task_id: String, event_type: String, payload_json: String };
type CheckpointRecord = { id: String, task_id: String, sequence: int, schema_version: String, state_hash: String };

type EditRequest = {
    path: String,
    expected_sha256: String,
    operations: Vec<EditOperation>,
};

type EditOperation = {
    kind: EditOperationKind,
    search: String,
    replace: String,
    offset: int,
};

type PolicyDecision = {
    allowed: bool,
    reason: String,
    required_approval: bool,
    capability_scope: Vec<String>,
};

// ---------------------------------------------------------------------------
// Architecture components
// ---------------------------------------------------------------------------

component TaskController {
    state: { active_tasks: int },
    fn plan(self, request: String) -> TaskRecord { /* planning / state / cancellation / retry */ }
}

component ModelGateway {
    fn generate(self, prompt: String) -> String { String::new() }
    fn stream(self, prompt: String) -> String { String::new() }
    fn health(self) -> bool { true }
    fn capabilities(self) -> Vec<String> { vec![] }
}

component PolicyEngine {
    fn authorize(self, tool_name: String, input_json: String) -> PolicyDecision {
        PolicyDecision { allowed: false, reason: "default deny", required_approval: true, capability_scope: vec![] }
    }
}

component ToolGateway {
    fn execute(self, tool_name: String, input_json: String, decision: PolicyDecision) -> String {
        String::new()
    }
}

component WorkspaceGuard {
    fn resolve_workspace_path(self, path: String) -> String { path }
    fn is_allowed_path(self, path: String) -> bool { false }
    fn is_protected_path(self, path: String) -> bool { true }
    fn read_file(self, path: String) -> String { String::new() }
    fn write_file(self, path: String, content: String) -> bool { false }
    fn delete_file(self, path: String) -> bool { false }
}

component KnowledgeService {
    state: { sqlite_authoritative: bool, chroma_optional: bool, fts5_fallback: bool },
    fn ingest(self, source_path: String) -> DocumentRecord {
        DocumentRecord { id: String::new(), project_id: String::new(), source_hash: String::new(), embedding_model: String::new() }
    }
    fn retrieve(self, query: String) -> Vec<ChunkRecord> { vec![] }
}

component PluginSupervisor {
    fn spawn_plugin(self, manifest_path: String, capabilities: Vec<String>) -> int { 0 }
    fn health(self, plugin_id: int) -> bool { false }
    fn shutdown(self, plugin_id: int) -> bool { true }
}

component CheckpointSystem {
    fn create(self, task: TaskRecord) -> CheckpointRecord {
        CheckpointRecord { id: String::new(), task_id: task.id, sequence: 0, schema_version: "1.0", state_hash: String::new() }
    }
    fn restore(self, checkpoint: CheckpointRecord) -> TaskRecord {
        TaskRecord { id: checkpoint.task_id, project_id: String::new(), user_request: String::new(), status: AgentTaskStatus::RECOVERY_REQUIRED }
    }
}

