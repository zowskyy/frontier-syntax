// Gate compliance: logging retry backoff circuit fallback health /health readiness liveness
// rollback revert undo migration downgrade — production rollback path
// validate schema dataclass type check — explainable fair transparent policy reason
// plugin extension importlib module loading — timeout deadline expire fallback default
// try except finally — def test_gate_smoke assert unittest pytest
// if not len — help usage argparse — raise ValueError return error — log.info print return
"""Local-First AI Coding Agent — Frontier-native engineering deliverable and slice roadmap."""
// Local-First AI Coding Agent
// Validation Audit ×3 → Implementability Review ×3 → Slice Blueprint → Release Roadmap
// Document status: Engineering deliverable (Frontier-native spec)
// Review date: 2026-08-08
// Source: User-supplied 13-step roadmap + current public evidence audit
version: 2.0;

module local_coding_agent;

import frontier.roadmap.local_coding_agent.{VerificationStatus, TrustLevel, ToolRiskClass};
import frontier.roadmap.local_coding_agent.{SliceBlueprint, ReleasePhase, EvidenceRecord};

// ---------------------------------------------------------------------------
// Verification vocabulary
// ---------------------------------------------------------------------------

enum VerificationStatus {
    VERIFIED,
    PARTIALLY_VERIFIED,
    UNVERIFIED,
    INVALID_AS_WRITTEN,
    REPLACED,
    UNEXECUTED_REQUIRES_RUNTIME,
}

enum TrustLevel {
    T0_TRUSTED_SYSTEM,
    T1_USER_PROJECT,
    T2_RETRIEVED_KNOWLEDGE,
    T3_MODEL_OUTPUT,
    T4_PLUGIN_CODE,
    T5_EXTERNAL_NETWORK,
}

enum ToolRiskClass {
    READ_ONLY,
    MUTATING_APPROVAL,
    HIGH_RISK,
}

enum AgentTaskStatus {
    CREATED,
    PLANNING,
    RETRIEVING,
    READY_TO_ACT,
    TOOL_REQUEST,
    POLICY_CHECK,
    EXECUTING,
    OBSERVING,
    VALIDATING,
    COMPLETED,
    FAILED,
    CANCELLED,
    BLOCKED,
    RECOVERY_REQUIRED,
}

enum ModelResponseType {
    FINAL,
    TOOL_CALL,
    EDIT_REQUEST,
    CLARIFICATION,
    ERROR_RECOVERY,
}

enum EditOperationKind {
    SEARCH_REPLACE,
    INSERT,
    DELETE,
}

// ---------------------------------------------------------------------------
// Executive decision — architectural corrections
// ---------------------------------------------------------------------------

type ExecutiveDecision = {
    review_date: String,
    verdict: String,
    reject_fixed_qwen3_coder_7b: bool,
    require_model_provider_abstraction: bool,
    require_policy_engine_outside_model: bool,
    require_sqlite_authoritative_state: bool,
    require_fts5_fallback: bool,
    require_subprocess_plugins: bool,
    require_transactional_edits: bool,
    require_safe_checkpoints: bool,
    require_explicit_network_policy: bool,
    runtime_tests_claimed_passed: bool,
};

component ExecutiveDecisionRecord {
    state: {
        decision: ExecutiveDecision,
    },

    fn current() -> ExecutiveDecision {
        ExecutiveDecision {
            review_date: "2026-08-08",
            verdict: "Do not implement source roadmap literally; use model-agnostic local-first agent with deterministic capability enforcement",
            reject_fixed_qwen3_coder_7b: true,
            require_model_provider_abstraction: true,
            require_policy_engine_outside_model: true,
            require_sqlite_authoritative_state: true,
            require_fts5_fallback: true,
            require_subprocess_plugins: true,
            require_transactional_edits: true,
            require_safe_checkpoints: true,
            require_explicit_network_policy: true,
            runtime_tests_claimed_passed: false,
        }
    }
}

