// ---------------------------------------------------------------------------
// Evidence record format
// ---------------------------------------------------------------------------

type EvidenceRecord = {
    test_id: String,
    name: String,
    date: String,
    software_version: String,
    platform: String,
    result: String,
    artifacts: Vec<String>,
};

component EvidencePackage {
    fn structure() -> Vec<String> {
        vec![
            "evidence/dependency/model-matrix.json",
            "evidence/security/prompt-injection/",
            "evidence/security/path-traversal/",
            "evidence/security/ssrf/",
            "evidence/reliability/crash-recovery/",
            "evidence/performance/desktop/",
            "evidence/performance/android/",
            "evidence/performance/ios/",
            "evidence/knowledge/ingestion/",
            "evidence/integration/coding-tasks/",
            "evidence/mobile/android/",
            "evidence/mobile/ios/",
            "evidence/release/sbom/",
            "evidence/release/checksums/",
            "evidence/release/test-report/",
        ]
    }

    fn example_record() -> EvidenceRecord {
        EvidenceRecord {
            test_id: "SEC-PATH-001",
            name: "workspace path traversal",
            date: "2026-08-08",
            software_version: "0.1.0",
            platform: "linux",
            result: "PASS",
            artifacts: vec!["logs/SEC-PATH-001.json"],
        }
    }
}

// ---------------------------------------------------------------------------
// Public release gate — six current-evidence checks
// ---------------------------------------------------------------------------

type PublicReleaseCheck = {
    id: int,
    description: String,
    status: VerificationStatus,
};

component PublicReleaseGate {
    fn six_checks() -> Vec<PublicReleaseCheck> {
        vec![
            check(1, "Model recommendations current with evidence", VerificationStatus::PARTIALLY_VERIFIED),
            check(2, "Active repositories verified", VerificationStatus::PARTIALLY_VERIFIED),
            check(3, "Package licenses documented", VerificationStatus::PARTIALLY_VERIFIED),
            check(4, "Security advisories reviewed", VerificationStatus::UNVERIFIED),
            check(5, "Current prompt injection defenses documented", VerificationStatus::PARTIALLY_VERIFIED),
            check(6, "Current mobile OS testing on real devices", VerificationStatus::UNEXECUTED_REQUIRES_RUNTIME),
        ]
    }

    fn check(id: int, description: String, status: VerificationStatus) -> PublicReleaseCheck {
        PublicReleaseCheck { id, description, status }
    }

    fn go_decision_allowed(self) -> bool {
        false
    }
}

// ---------------------------------------------------------------------------
// Implementation rule — slice completion contract
// ---------------------------------------------------------------------------

component ImplementationRule {
    fn slice_completion_pipeline() -> Vec<String> {
        vec![
            "SPECIFY",
            "IMPLEMENT",
            "UNIT TEST",
            "SECURITY TEST",
            "INTEGRATION TEST",
            "DOCUMENT",
            "UPDATE PROJECT_STATE.md",
            "COMMIT",
            "NEXT SLICE",
        ]
    }

    fn rule() -> String {
        String::from("A slice is complete only when acceptance criteria have executable evidence — not when code exists")
    }
}

// ---------------------------------------------------------------------------
// Source roadmap phase mapping (original 13 phases)
// ---------------------------------------------------------------------------

type SourceRoadmapPhase = {
    id: int,
    name: String,
    mapped_slices: Vec<int>,
};

component SourceRoadmapMapping {
    fn original_thirteen() -> Vec<SourceRoadmapPhase> {
        vec![
            map(1, "Dependency Verification", vec![1, 4, 12, 13]),
            map(2, "Security Audit", vec![2, 7, 22, 30]),
            map(3, "Reliability Testing", vec![21, 23]),
            map(4, "Performance Benchmarking", vec![25, 29, 31]),
            map(5, "Knowledge Augmentation Validation", vec![24]),
            map(6, "Qwen-Specific Behavior Testing", vec![25]),
            map(7, "Plugin System Validation", vec![18, 19]),
            map(8, "Mobile Deployment Testing", vec![27, 28, 29, 30]),
            map(9, "Knowledge Ingestion Pipeline", vec![10, 11, 14, 15]),
            map(10, "End-to-End Integration Testing", vec![26]),
            map(11, "Checkpoint and Recovery", vec![20, 21]),
            map(12, "Documentation and Release Preparation", vec![32, 33]),
            map(13, "Public Release Checklist", vec![34, 35, 36]),
        ]
    }

    fn map(id: int, name: String, mapped_slices: Vec<int>) -> SourceRoadmapPhase {
        SourceRoadmapPhase { id, name, mapped_slices }
    }
}
