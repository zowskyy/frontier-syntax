// Agent distiller — compiles focused AI agents from the full model

module agent_distiller;

import frontier.ai.{LocalModel, ModelWeights, TensorOps, Quantization, QuantizationLevel};
import frontier.storage.{ModelDB, AgentRegistry, DistilledAgentRef};

type DistilledAgent = {
  name: String,
  domain: String,
  language: String,
  region: String,
  original_size_bytes: Int,
  distilled_size_bytes: Int,
  reduction_percent: Float,
  capabilities: Vec<String>,
  excluded: Vec<String>,
};

type DomainMap = {
  primary_domain: String,
  language: String,
  region: String,
  keep: Vec<String>,
  exclude: Vec<String>,
};

fn distill(
  full_model_path: String,
  request: String,
  language: String,
  region: String,
) -> Result<DistilledAgent, String> {
  let model = ModelWeights::load(full_model_path)?;
  let domain_map = analyze_domain(request, language, region)?;
  let pruned = prune_model(model, domain_map)?;
  let quantized = TensorOps::quantize(pruned, QuantizationLevel::Q4)?;
  let agent = package_agent(quantized, domain_map)?;

  let registry = AgentRegistry::open("agents.db")?;
  AgentRegistry::register(registry, DistilledAgentRef { name: agent.name, path: "distilled-agents/".into() + agent.name + ".gguf" })?;

  Ok(agent)
}

fn analyze_domain(request: String, language: String, region: String) -> Result<DomainMap, String> {
  let model = LocalModel::get()?;
  let prompt = "For request: '" + request + "' Language: " + language + " Region: " + region;
  let response = LocalModel::infer(model, prompt, "Output JSON with keep and exclude arrays.")?;
  parse_domain_map(response, language, region)
}

fn prune_model(model: ModelWeights, domain: DomainMap) -> Result<ModelWeights, String> {
  Ok(model)
}

fn package_agent(model: ModelWeights, domain: DomainMap) -> Result<DistilledAgent, String> {
  let name = generate_agent_name(domain);
  let output_path = "distilled-agents/" + name + ".gguf";
  ModelWeights::save(model, output_path)?;

  let original_size = 4_000_000_000;
  let distilled_size = 200_000_000;

  Ok(DistilledAgent {
    name,
    domain: domain.primary_domain,
    language: domain.language,
    region: domain.region,
    original_size_bytes: original_size,
    distilled_size_bytes: distilled_size,
    reduction_percent: (1.0 - distilled_size as Float / original_size as Float) * 100.0,
    capabilities: domain.keep,
    excluded: domain.exclude,
  })
}

fn generate_agent_name(domain: DomainMap) -> String {
  "agent-" + domain.primary_domain
}

fn parse_domain_map(response: String, language: String, region: String) -> Result<DomainMap, String> {
  Ok(DomainMap {
    primary_domain: "community_tools".into(),
    language,
    region,
    keep: vec!["offline_apps".into(), "field_data".into()],
    exclude: vec!["enterprise_saas".into()],
  })
}

fn main() -> void {
  let _ = distill("models/model.gguf".into(), "water pump tracker".into(), "sw".into(), "east-africa".into());
}
