// frontier.storage — SQLite + offline sync + knowledge graphs

module frontier.storage;

type Database = opaque;
type Query = opaque;
type Sync = opaque;
type Context = opaque;
type Memory = opaque;
type KnowledgeGraph = opaque;
type PatternDB = opaque;
type ModelDB = opaque;
type AgentRegistry = opaque;

extern fn Database::open(path: &str) -> Result<Database, String>;
extern fn Database::create_table(db: Database, name: &str, columns: Vec<(String, String)>) -> Result<(), String>;
extern fn Database::insert(db: Database, table: &str, data: String) -> Result<Int, String>;
extern fn Database::query(db: Database, sql: &str) -> Result<Vec<String>, String>;
extern fn Database::query_one(db: Database, sql: &str, params: Vec<Int>) -> Result<String, String>;
extern fn Database::execute(db: Database, sql: &str, params: Vec<String>) -> Result<(), String>;

extern fn Sync::new() -> Sync;
extern fn Sync::on_connect(sync: Sync, callback: &str);
extern fn Sync::push(sync: Sync, change: String) -> Result<(), String>;

extern fn KnowledgeGraph::load(path: &str) -> Result<KnowledgeGraph, String>;
extern fn KnowledgeGraph::query_adjacent(graph: KnowledgeGraph, need: String) -> Result<Vec<Pattern>, String>;
extern fn KnowledgeGraph::query_enablers(graph: KnowledgeGraph, domain: String) -> Result<Vec<Enabler>, String>;
extern fn KnowledgeGraph::query_scaling(graph: KnowledgeGraph, domain: String, region: String) -> Result<Vec<ScalingPath>, String>;

extern fn PatternDB::load(path: &str) -> Result<PatternDB, String>;
extern fn PatternDB::query_similar(db: PatternDB, need: String, region: String, language: String, limit: Int) -> Result<Vec<ImpactRecord>, String>;

extern fn AgentRegistry::open(path: &str) -> Result<AgentRegistry, String>;
extern fn AgentRegistry::register(registry: AgentRegistry, agent: DistilledAgentRef) -> Result<(), String>;

type Pattern = { description: String, rationale: String };
type Enabler = { description: String, impact_story: String };
type ScalingPath = { description: String, why_now: String };
type ImpactRecord = { person: String, problem_solved: String, solution_built: String, outcome_achieved: String, community: String };
type DistilledAgentRef = { name: String, path: String };
