// frontier.ui — Native platform bindings (UIKit / Android Views)

module frontier.ui;

type Screen = opaque;
type Button = opaque;
type List = opaque;
type TextInput = opaque;
type Card = opaque;
type Navigation = opaque;
type DatePicker = opaque;
type Camera = opaque;

extern fn Screen::new(title: &str) -> Screen;
extern fn Screen::set_icon(screen: Screen, icon: &str);
extern fn Screen::set_language(screen: Screen, lang: &str);
extern fn Screen::add_widget(screen: Screen, widget: TextInput);
extern fn Screen::add_button(screen: Screen, id: &str, label: &str, action: &str);
extern fn Screen::add_list(screen: Screen, list: List);
extern fn Screen::set_navigation(screen: Screen, nav: Navigation);
extern fn Screen::render(screen: Screen);
extern fn Screen::close(screen: Screen);

extern fn TextInput::new(id: &str) -> TextInput;
extern fn TextInput::set_placeholder(input: TextInput, text: &str);
extern fn TextInput::get_text(input: TextInput) -> String;
extern fn TextInput::on_change(input: TextInput, callback: &str);

extern fn Button::new(label: &str) -> Button;
extern fn Button::on_click(button: Button, callback: &str);

extern fn List::new(id: &str) -> List;
extern fn List::add_card(list: List, card: Card);

extern fn Card::new(content: &str) -> Card;
extern fn Card::add_field(card: Card, label: &str, value: String);
extern fn Card::add_button(card: Card, label: &str, action: &str);

extern fn Navigation::new() -> Navigation;
extern fn Navigation::add_tab(nav: Navigation, label: &str, action: &str);

extern fn DatePicker::new(id: &str) -> DatePicker;
extern fn DatePicker::get_date(picker: DatePicker) -> String;
