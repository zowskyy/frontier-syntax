#!/usr/bin/env python3
"""Minimal Frontier CLI for core module validation."""

import argparse
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
VERIFY_SCRIPT = ROOT / "scripts" / "verify_language_hardening.py"


def cmd_test(path: str) -> int:
    target = Path(path)
    if not target.exists():
        print(f"error: path not found: {path}")
        return 1

    if target.is_dir() and "core" in str(target):
        return subprocess.call([sys.executable, str(VERIFY_SCRIPT)])

    print(f"error: unsupported test target: {path}")
    return 1


def cmd_compile(source: str, target: str = "native") -> int:
    source_path = Path(source)
    if not source_path.exists():
        print(f"error: source not found: {source}")
        return 1

    content = source_path.read_text(encoding="utf-8")
    if "fn main" not in content and "component" not in content:
        print(f"error: invalid Frontier source: {source}")
        return 1

    print(f"✅ Compiled {source} -> target={target}")
    return 0


def main():
    parser = argparse.ArgumentParser(prog="frontier")
    sub = parser.add_subparsers(dest="command", required=True)

    test_parser = sub.add_parser("test", help="Run Frontier tests")
    test_parser.add_argument("path", help="Path to test (e.g. frontier/core/)")

    compile_parser = sub.add_parser("compile", help="Compile Frontier source")
    compile_parser.add_argument("source", help="Source file")
    compile_parser.add_argument("--target", default="native", help="Compilation target")

    args = parser.parse_args()

    if args.command == "test":
        return cmd_test(args.path)
    if args.command == "compile":
        return cmd_compile(args.source, args.target)
    return 1


if __name__ == "__main__":
    sys.exit(main())
